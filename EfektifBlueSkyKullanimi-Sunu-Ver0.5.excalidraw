    {
      "id": "Rj0TO6WERpcZ0Y4dbkvhP",
      "type": "text",
      "x": 490.2605868978101,
      "y": -106.49404148382234,
      "width": 1834.62081510219,
      "height": 43.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "ycSSLGQcnurioPYChdiqD",
      "index": "b4Pzzzz",
      "roundness": null,
      "seed": 1709565424,
      "version": 488,
      "versionNonce": 662102512,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1744651129698,
      "link": null,
      "locked": false,
      "text": "Bu sunumda istediğiniz gibi gezinebilirsiniz. Sizin için çizim yapma alanları da bıraktım eğer ilginizi çekerse ^_^ Kısımları frame olarak grupladım; gitmek istediğiniz kısım olursa Ctrl + F yapıp bölümün adını yazarak kolayca erişebilirsiniz. Tabi bu tüm\nmetinler için geçerli.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bu sunumda istediğiniz gibi gezinebilirsiniz. Sizin için çizim yapma alanları da bıraktım eğer ilginizi çekerse ^_^ Kısımları frame olarak grupladım; gitmek istediğiniz kısım olursa Ctrl + F yapıp bölümün adını yazarak kolayca erişebilirsiniz. Tabi bu tüm metinler için geçerli.",
      "autoResize": false,
      "lineHeight": 1.35
    },
