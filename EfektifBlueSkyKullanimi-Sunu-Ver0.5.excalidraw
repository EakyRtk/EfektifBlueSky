    {
      "id": "qBLEFaf7nZe3ZOm80iIlI",
      "type": "text",
      "x": 3061.786103424289,
      "y": 1974.7219773640452,
      "width": 757.4005905757108,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "6-scwNLaNw5g4w_ixG33a",
      "index": "b0ezzzzzzzzzzzzt",
      "roundness": null,
      "seed": 279579983,
      "version": 561,
      "versionNonce": 1202160225,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1744571282447,
      "link": null,
      "locked": false,
      "text": "SkyFeed, BlueSky gibi bir BlueSky kullanma sitesidir. Orijinal BlueSky sitesine göre\nbirkaç farklı özelliği bulunmakta.\nBunlardan ilki birden fazla feed'i sabitleyip aynı anda takip edebilmek. Aşağıda dört\nfarklı listeyi sabitlediğim gözüküyor.\nAncak sadece paylaşmların üstünü boyayarak kapadım.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SkyFeed, BlueSky gibi bir BlueSky kullanma sitesidir. Orijinal BlueSky sitesine göre birkaç farklı özelliği bulunmakta.\nBunlardan ilki birden fazla feed'i sabitleyip aynı anda takip edebilmek. Aşağıda dört farklı listeyi sabitlediğim gözüküyor.\nAncak sadece paylaşmların üstünü boyayarak kapadım.",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "EZXCVtuEsOkypSmPl-1Xh",
      "type": "text",
      "x": 3061.786102899492,
      "y": 2584.801173102424,
      "width": 724.2666625976562,
      "height": 81,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "6-scwNLaNw5g4w_ixG33a",
      "index": "b0ezzzzzzzzzzzzx",
      "roundness": null,
      "seed": 503692751,
      "version": 163,
      "versionNonce": 173084719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1744571282447,
      "link": null,
      "locked": false,
      "text": "SkyFeed'in genel öne çıkan özelliği ise kendi özel feedinizi oluşturabilme aracıdır.\n\nBunu basitçe nasıl yapabileceğinizi kısa bir videoda açıkladım:",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SkyFeed'in genel öne çıkan özelliği ise kendi özel feedinizi oluşturabilme aracıdır.\n\nBunu basitçe nasıl yapabileceğinizi kısa bir videoda açıkladım:",
      "autoResize": true,
      "lineHeight": 1.35
    },
