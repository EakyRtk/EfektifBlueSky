    {
      "id": "6swlOX-rge5hTV_Gl2QEp",
      "type": "text",
      "x": 490.26058732054196,
      "y": -411.90888998931484,
      "width": 1834.620814903481,
      "height": 189,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "ycSSLGQcnurioPYChdiqD",
      "index": "b4Pz",
      "roundness": null,
      "seed": 1588062704,
      "version": 1881,
      "versionNonce": 294144496,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1744651129697,
      "link": null,
      "locked": false,
      "text": "Bu sunu BlueSky ile ilgili bazı temellere değinir ve önermelerde bulunur. Bu sununun var olmasının bir nedeni BlueSky'ın diğer merkezi sosyal medya araçlarından ayrılmasıdır. BlueSky'ın merkeziyetsiz\nolması bir avantaj olsa da mevcut temel özelliklerin bilinmesinin oldukça önemli olduğunu düşünüyorum. Uygulama üzerinde daha güç ve özgürlük sahibi olmanız en azından belirli bilgi sahibi olmanızı\ngerektirdiğini düşünüyorum, yoksa diğer sitelerin aynısını gibi işlediğini sanıp hayal kırıklıkları yaşayabilirsiniz. \n\n\nBu sunuyu sırasıyla;  algoritma kısmından, sonra oradan feed kısmına atlayarak bakabilirsiniz. Bunlar en temel noktalar; sonrasında post bookmark/pinleme nasıl yapılır, hangi üçüncü parti yazılımlar var\ngibi konulara geçebilirsiniz. Bunlar bu temel öğeleri açıklayan başlıklar. Eğer özet bilgi isterseniz üç farklı seviye olarak BlueSky kullanma alet çantası kısmına bakabilirsiniz.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bu sunu BlueSky ile ilgili bazı temellere değinir ve önermelerde bulunur. Bu sununun var olmasının bir nedeni BlueSky'ın diğer merkezi sosyal medya araçlarından ayrılmasıdır. BlueSky'ın merkeziyetsiz olması bir avantaj olsa da mevcut temel özelliklerin bilinmesinin oldukça önemli olduğunu düşünüyorum. Uygulama üzerinde daha güç ve özgürlük sahibi olmanız en azından belirli bilgi sahibi olmanızı gerektirdiğini düşünüyorum, yoksa diğer sitelerin aynısını gibi işlediğini sanıp hayal kırıklıkları yaşayabilirsiniz. \n\n\nBu sunuyu sırasıyla;  algoritma kısmından, sonra oradan feed kısmına atlayarak bakabilirsiniz. Bunlar en temel noktalar; sonrasında post bookmark/pinleme nasıl yapılır, hangi üçüncü parti yazılımlar var gibi konulara geçebilirsiniz. Bunlar bu temel öğeleri açıklayan başlıklar. Eğer özet bilgi isterseniz üç farklı seviye olarak BlueSky kullanma alet çantası kısmına bakabilirsiniz.",
      "autoResize": false,
      "lineHeight": 1.35
    },
