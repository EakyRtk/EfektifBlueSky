      ],
      "updated": 1744645930018,
      "link": null,
      "locked": false,
      "text": "Buraya yazdığınız kelime, kelime2 herhangi birini\niçeren paylaşımlar,\n\"kelime ve kelime\" ise o iki kelimeyi de aynı anda\niçeren paylaşımlar,\ngüncel ve canlı olarak önünüze düşer.\n\nProfillere ve paylaşımlara tıklarsanız BlueSky'da açılır.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Buraya yazdığınız kelime, kelime2 herhangi birini içeren paylaşımlar,\n\"kelime ve kelime\" ise o iki kelimeyi de aynı anda içeren paylaşımlar,\ngüncel ve canlı olarak önünüze düşer.\n\nProfillere ve paylaşımlara tıklarsanız BlueSky'da açılır.",
      "autoResize": false,
      "lineHeight": 1.35
    },
