      "updated": 1744651155070,
      "link": null,
      "locked": false,
      "text": "- FEEDLER kısmında temel feedleri sabitleyin. Bu feedlerde gezinin.\n- Güncel kalmak istediğiniz kullanıcıları listelere ekleyip sabitleyin. Buraları da ayrıca takip edin.\n- Algoritma alanındaki konulara dikkat edin. (Quote, yorum çok önemli. Görselleri kendinizmiş gibi paylaşmayın asıl paylaşıma destek verin.)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- FEEDLER kısmında temel feedleri sabitleyin. Bu feedlerde gezinin.\n- Güncel kalmak istediğiniz kullanıcıları listelere ekleyip sabitleyin. Buraları da ayrıca takip edin.\n- Algoritma alanındaki konulara dikkat edin. (Quote, yorum çok önemli. Görselleri kendinizmiş gibi paylaşmayın asıl paylaşıma destek verin.)",
      "autoResize": true,
      "lineHeight": 1.35
    },
